{
  "name": "tacet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Tacet - detect frontend regressions caused by backend API changes",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b packages/cli packages/mcp",
    "build:jar": "npm run build:jar -w @tacet-api/extractor-java",
    "clean": "tsc -b packages/cli packages/mcp --clean",
    "test": "vitest run",
    "test:jvm": "npm run test:jvm -w @tacet-api/extractor-java",
    "pack:all": "node scripts/pack-all.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "license": "Apache-2.0"
}
