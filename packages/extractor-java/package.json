{
  "name": "@api-tacet/extractor-java",
  "version": "0.1.0",
  "description": "Tacet Spring Boot extractor (JavaParser): endpoints and DTO JSON shapes",
  "keywords": [
    "tacet",
    "spring-boot",
    "javaparser",
    "api-contract"
  ],
  "license": "Apache-2.0",
  "author": "Heonjin Jeong",
  "homepage": "https://github.com/heonjinjeong/tacet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heonjinjeong/tacet.git",
    "directory": "packages/extractor-java"
  },
  "bugs": {
    "url": "https://github.com/heonjinjeong/tacet/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "src",
    "jvm/build/libs/tacet-java-extractor.jar",
    "!**/*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "build:jar": "cd jvm && ./gradlew --quiet jar",
    "test:jvm": "cd jvm && ./gradlew --quiet test",
    "prepack": "npm run build:jar"
  },
  "dependencies": {
    "@api-tacet/core": "^0.1.0"
  }
}
