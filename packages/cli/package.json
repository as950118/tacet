{
  "name": "@api-tacet/cli",
  "version": "0.1.0",
  "description": "Tacet CLI: find frontend code broken by backend API changes, check frontend code against the real API",
  "keywords": [
    "tacet",
    "api",
    "breaking-changes",
    "spring-boot",
    "typescript",
    "ci",
    "cli"
  ],
  "license": "Apache-2.0",
  "author": "Heonjin Jeong",
  "homepage": "https://github.com/heonjinjeong/tacet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heonjinjeong/tacet.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/heonjinjeong/tacet/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "tacet": "./dist/bin.js"
  },
  "files": [
    "dist",
    "src",
    "!**/*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "@api-tacet/ai-anthropic": "^0.1.0",
    "@api-tacet/core": "^0.1.0",
    "@api-tacet/extractor-java": "^0.1.0",
    "@api-tacet/extractor-typescript": "^0.1.0",
    "commander": "^15.0.0"
  }
}
